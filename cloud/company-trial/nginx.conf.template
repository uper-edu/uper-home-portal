# Company-trial SAME-ORIGIN exception approved by user. Not yet installed.
# Integrate through the company deployment tool; never overwrite generated configs blindly.
server {
  listen 80;
  server_name home.prototype.uperedu.com;
  location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://home.prototype.uperedu.com$request_uri; }
}
server {
  listen 443 ssl;
  http2 on;
  server_name home.prototype.uperedu.com;
  ssl_certificate /etc/nginx/ssl/letsencrypt/live/home.prototype.uperedu.com/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/letsencrypt/live/home.prototype.uperedu.com/privkey.pem;
  # REQUIRED: replace with approved VPN/private testing ranges. Default must remain deny-all.
  # allow REPLACE_WITH_APPROVED_VPN_CIDR;
  deny all;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
  add_header X-Content-Type-Options nosniff always;
  resolver 127.0.0.11 valid=10s;
  client_max_body_size 16m;
  location / {
    set $home_upstream home-api:8080;
    proxy_pass http://$home_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host home.prototype.uperedu.com;
    proxy_set_header X-Forwarded-Host home.prototype.uperedu.com;
    proxy_set_header X-Forwarded-Proto https;
    # Overwrite attacker-supplied chains; do not use proxy_add_x_forwarded_for.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 180s;
  }
}
