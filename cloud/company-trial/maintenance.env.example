# MAINTENANCE TEMPLATE ONLY. Keep a separate private 0600 file; never use as the app runtime env.
PORTAL_DEPLOYMENT=company-trial
ACCESS_RECOVERY_MAINTENANCE=true
NODE_ENV=production
APP_ENV=production
PORTAL_DATABASE_DRIVER=mysql
TRIAL_DATASET=synthetic
PLATFORM_MODE=local
PORT=8080
APP_URL=https://home.prototype.uperedu.com
ACCESS_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
# Exact nginx peer address on the private Docker backend network; no CIDR/wildcards.
ACCESS_TRUSTED_PROXIES=REPLACE_WITH_EXACT_NGINX_PRIVATE_PEER
ACCESS_OPERATION_KEY=REPLACE_WITH_RANDOM_STABLE_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_ALLOW_TEST_PASSWORDS=false
# No bootstrap password file is used for recovery of EXISTING accounts.
MYSQL_TRIAL_URL=mysql://home:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@mysql:3306/uper_trial_home
# CA CONTENT with actual line breaks, delivered through private environment injection (not a pathname).
MYSQL_CA_PEM="REPLACE_WITH_TRUSTED_CA_PEM_CONTENT"
# MYSQL_TRIAL_SOCKET must be absent. These tools live in a separate maintenance container, not the app.
MYSQL_BIN_DIRECTORY=/usr/bin
TRIAL_FRONTEND_DIRECTORY=/app/web
PORTAL_WORKER_ENABLED=false
PORTAL_NOTIFICATION_MODE=simulation
LARK_TEST_GROUP=CRM_Leads_Update
# Maintenance does not need AI keys or Lark Webhooks. Do not copy those secrets into this file.

# Exact approved target only. For a DB restore select a NEW EMPTY uper_trial_ schema and bind the permit to its backup SHA256.
# Restore/apply additionally require --services-stopped; queries/previews do not reset passwords.
