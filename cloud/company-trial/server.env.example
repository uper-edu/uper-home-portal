# TARGET TEMPLATE ONLY. Never use the local3000 .env or export this file to a browser.
PORTAL_DEPLOYMENT=company-trial
NODE_ENV=production
APP_ENV=production
PORTAL_DATABASE_DRIVER=mysql
TRIAL_DATASET=synthetic
PLATFORM_MODE=local
PORT=8080
APP_URL=https://home.prototype.uperedu.com
UPER_PORTAL_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
# Exact nginx peer address on the private Docker backend network; no CIDR/wildcards.
ACCESS_TRUSTED_PROXIES=REPLACE_WITH_EXACT_NGINX_PRIVATE_PEER
ACCESS_ALLOW_TEST_PASSWORDS=false
# Fresh test database only. Set the shared temporary password in the private .env.test.
# Leave it blank for an already initialized database. New accounts must change it on first login.
ACCESS_INITIAL_PASSWORD=
MYSQL_TRIAL_URL=mysql://home:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@mysql:3306/uper_trial_home
# CA CONTENT with actual line breaks, delivered through private environment injection (not a pathname).
MYSQL_CA_PEM="REPLACE_WITH_TRUSTED_CA_PEM_CONTENT"
# MYSQL_TRIAL_SOCKET must be absent. These tools live in a separate maintenance container, not the app.
# MYSQL_BIN_DIRECTORY=/usr/bin
TRIAL_FRONTEND_DIRECTORY=/app/web
# Keep the worker paused for first-start checks. Omit this setting for normal startup.
# Group bot Webhook URL for the built-in channel. Fill only in the private server environment.
LARK_GROUP_CRM=
OPENAI_API_KEY=REPLACE_WITH_EXISTING_AUTHORIZED_KEY
DEEPSEEK_API_KEY=REPLACE_WITH_EXISTING_AUTHORIZED_KEY
# Inject any existing approved model/base-URL overrides separately; no frontend VITE_* secrets.
