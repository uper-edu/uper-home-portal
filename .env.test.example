# UPER Home Portal · 公司测试环境配置模板
# 复制后填入本环境私有值，文件权限为 0600。

# ── 运行与站点 ──
UPER_PORTAL_ENV=test
UPER_PORTAL_ENV_SOURCE=injected
UPER_PORTAL_DEPLOYMENT=company-trial
NODE_ENV=production
APP_ENV=production
PLATFORM_MODE=local
PORT=8080
APP_URL=https://home.prototype.uperedu.com
# 招生邮件链接和 Lark 回调校验使用的公司测试站 HTTPS 来源。
UPER_PORTAL_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
TRIAL_FRONTEND_DIRECTORY=/app/web

# ── MySQL ──
TRIAL_DATASET=synthetic
MYSQL_TRIAL_URL=
# 获准的容器内部 MySQL 直连可用 disabled。需要验证式 TLS 时使用 required 并提供 CA。
MYSQL_TLS_MODE=disabled
MYSQL_CA_PEM=

# ── 访问保护与后台任务 ──
ACCESS_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
# 填写可信反向代理的具体私网 IP，多个地址用逗号分隔。
ACCESS_TRUSTED_PROXIES=
UPER_PORTAL_WORKER_ENABLED=false

# ── 集成凭证 ──
# 凭证迁移前由运维提供独立 test 密钥环。填容器内可读的绝对路径，文件权限为 0600。
UPER_PORTAL_CREDENTIAL_KEYRING_FILE=

# ── 报名与招生邮件 ──
UPER_PORTAL_ENROLLMENT_SERVICE_ENABLED=false
# 隔离报名验收可设 simulation，并填写下方专用库和私有邮箱路径。
# 正式 SMTP 投递前核对发信池和发件账号。
UPER_PORTAL_ENROLLMENT_MAIL_TRANSPORT=
# 模拟投递只接受与连接库名完全相符的独立测试库，worker 须关闭。
UPER_PORTAL_ENROLLMENT_SIMULATION_DATABASE=
UPER_PORTAL_ENROLLMENT_SIMULATION_MAILBOX=

# ── 按需配置 ──
UPER_PORTAL_LOG_LEVEL=info
MYSQL_BIN_DIRECTORY=
# 全新公司测试库首次启动时，在私有 .env.test 设置统一临时密码。首次登录须改密。
# 已有账号可留空。旧部署若仍使用密码文件，可在私有配置保留 ACCESS_INITIAL_PASSWORDS_FILE。
ACCESS_INITIAL_PASSWORD=
UPER_PORTAL_BOOTSTRAP_SECRET_FILE=
UPER_PORTAL_TEST_DIRECTORY_ENABLED=false
UPER_PORTAL_TEST_DIRECTORY_INITIAL_PASSWORD=
# 仅在获准实际调用供应商时启用。
UPER_PORTAL_CREDENTIAL_PROVIDER_CHECKS=false
# 留空使用系统初始值。仅在后台尚无模型配置时用此项覆盖主模型。
OPENAI_MODEL=
UPER_PORTAL_COS_BUCKET=
UPER_PORTAL_COS_REGION=
UPER_PORTAL_COS_PREFIX=cms/

# ── 旧来源兼容 ──
# 测试站各项凭证迁移及验收完成前保留原值。操作见 docs/integration-credentials-runbook.md。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LARK_GROUP_CRM=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_OAUTH_REDIRECT_URI=https://home.prototype.uperedu.com/api/crm/lark/callback
LARK_TENANT_KEY=
PORTAL_GA_MEASUREMENT_ID=G-YTELN0GKTF
PORTAL_GA_API_SECRET=
PORTAL_GA_DISPATCH_ENABLED=false
PORTAL_COS_SECRET_ID=
PORTAL_COS_SECRET_KEY=
PORTAL_COS_SECURITY_TOKEN=
# 仍需解密旧 SMTP 或加密 Lark 群密文时，在私有配置保留对应原密钥。
# PORTAL_ENROLLMENT_MAIL_CREDENTIAL_KEY=
# LARK_WEBHOOK_ENCRYPTION_KEY=
