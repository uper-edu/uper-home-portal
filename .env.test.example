# Company cloud test. Copy to private .env.test; use no local customer data.
PORTAL_ENV=test
PORTAL_ENV_SOURCE=injected
PORTAL_DEPLOYMENT=company-trial
NODE_ENV=production
APP_ENV=production
PORT=8080
APP_URL=https://home.prototype.uperedu.com
PORTAL_DATABASE_DRIVER=mysql
PLATFORM_MODE=local
TRIAL_DATASET=synthetic
MYSQL_TRIAL_URL=mysql://home_trial:REPLACE_PASSWORD@mysql:3306/uper_trial_home
# User-approved direct MySQL connection only inside the company Docker network.
MYSQL_TLS_MODE=disabled
MYSQL_CA_PEM=
MYSQL_BIN_DIRECTORY=/usr/bin
TRIAL_FRONTEND_DIRECTORY=/app/web
PORTAL_WORKER_ENABLED=false
PORTAL_NOTIFICATION_MODE=simulation
ACCESS_OPERATION_KEY=REPLACE_WITH_STABLE_TEST_KEY
ACCESS_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
ACCESS_TRUSTED_PROXIES=REPLACE_WITH_EXACT_NGINX_PEER
ACCESS_ALLOW_TEST_PASSWORDS=false
ACCESS_INITIAL_PASSWORDS_FILE=/data/private/initial-passwords.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
LARK_GROUP_CRM=
LARK_TEST_GROUP=CRM_Leads_Update
VITE_UPER_MEASUREMENT_ID=

# Optional admin-only company test directory. Supply the actual initial password privately.
PORTAL_TEST_DIRECTORY_ENABLED=false
PORTAL_TEST_DIRECTORY_INITIAL_PASSWORD=REPLACE_WITH_TEST_INITIAL_PASSWORD
