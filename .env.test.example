# UPER Home Portal · 公司测试环境配置模板
# 复制后填入本环境私有值，文件权限为 0600。

# ── 运行与站点 ──
PORTAL_ENV=test
PORTAL_ENV_SOURCE=injected
PORTAL_DEPLOYMENT=company-trial
NODE_ENV=production
APP_ENV=production
PLATFORM_MODE=local
PORT=8080
APP_URL=https://home.prototype.uperedu.com
# 招生邮件链接和 Lark 回调校验使用的公司测试站 HTTPS 来源。
PORTAL_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
TRIAL_FRONTEND_DIRECTORY=/app/web

# ── MySQL ──
PORTAL_DATABASE_DRIVER=mysql
TRIAL_DATASET=synthetic
MYSQL_TRIAL_URL=
# 获准的容器内部 MySQL 直连可用 disabled。需要验证式 TLS 时使用 required 并提供 CA。
MYSQL_TLS_MODE=disabled
MYSQL_CA_PEM=

# ── 访问保护与后台任务 ──
ACCESS_PUBLIC_ORIGIN=https://home.prototype.uperedu.com
# 填写可信反向代理的具体私网 IP，多个地址用逗号分隔。
ACCESS_TRUSTED_PROXIES=
# 管理员恢复授权签名密钥，按环境独立保管。
ACCESS_OPERATION_KEY=
# 默认关闭后台 worker。
PORTAL_WORKER_ENABLED=false

# ── 集成凭证与浏览器统计 ──
# 凭证迁移前由运维提供独立 test 密钥环。填容器内可读的绝对路径，文件权限为 0600。
PORTAL_CREDENTIAL_KEYRING_FILE=
# 前端构建使用的公开 GA4 衡量 ID，须匹配 test 数据流。
VITE_UPER_MEASUREMENT_ID=G-YTELN0GKTF

# ── 报名与招生邮件 ──
# 是否开放报名服务，包括既有订单服务。
PORTAL_ENROLLMENT_SERVICE_ENABLED=false
# 默认留空。获准测试真实邮件后才启用 smtp，并先核对发信池和收件白名单。
PORTAL_ENROLLMENT_MAIL_TRANSPORT=
# 真实 SMTP 测试白名单，多个测试地址以逗号分隔。
PORTAL_ENROLLMENT_TEST_RECIPIENTS=

# ── 按需配置 ──
PORTAL_LOG_LEVEL=info
# 数据库备份和恢复工具目录。
MYSQL_BIN_DIRECTORY=
# 空库首次初始化时私下提供。已有账号可省略。
ACCESS_INITIAL_PASSWORD=
# 首次初始化时可选的私有密码文件，权限为 0600。
ACCESS_INITIAL_PASSWORDS_FILE=
PORTAL_BOOTSTRAP_SECRET_FILE=
PORTAL_TEST_DIRECTORY_ENABLED=false
PORTAL_TEST_DIRECTORY_INITIAL_PASSWORD=
# 仅在获准实际调用供应商时启用。
PORTAL_CREDENTIAL_PROVIDER_CHECKS=false
# 仅在后台尚无模型配置时覆盖 OpenAI 默认模型。
OPENAI_MODEL=gpt-6.2-sol
PORTAL_COS_BUCKET=
PORTAL_COS_REGION=
PORTAL_COS_PREFIX=cms/

# ── 旧来源兼容 ──
# 测试站各项凭证迁移及验收完成前保留原值。操作见 docs/integration-credentials-runbook.md。
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LARK_GROUP_CRM=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_OAUTH_REDIRECT_URI=https://home.prototype.uperedu.com/api/crm/lark/callback
LARK_TENANT_KEY=
PORTAL_GA_MEASUREMENT_ID=G-YTELN0GKTF
PORTAL_GA_API_SECRET=
PORTAL_GA_DISPATCH_ENABLED=false
PORTAL_COS_SECRET_ID=
PORTAL_COS_SECRET_KEY=
PORTAL_COS_SECURITY_TOKEN=
# 仍需解密旧 SMTP 或加密 Lark 群密文时，在私有配置保留对应原密钥。
# PORTAL_ENROLLMENT_MAIL_CREDENTIAL_KEY=
# LARK_WEBHOOK_ENCRYPTION_KEY=
