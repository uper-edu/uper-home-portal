# UPER Home Portal · 生产环境配置模板
# 复制后由运维提供正式环境私有值，文件权限为 0600。

# ── 运行与站点 ──
# 生产环境标识，须与构建包目标一致。
PORTAL_ENV=prod
# 容器注入完整配置时用 injected。由启动器读取私有环境文件时可省略。
PORTAL_ENV_SOURCE=injected
# 启用正式站部署校验。
PORTAL_DEPLOYMENT=production
# 正式配置和发布验收完成后才设为 true。
PORTAL_PRODUCTION_READY=false
# Node.js 正式运行模式。
NODE_ENV=production
# 启用正式环境访问保护。
APP_ENV=production
# 使用本站员工账号和本地身份模块。
PLATFORM_MODE=local
# 容器监听端口，须与反向代理一致。
PORT=8080
# 正式站规范 HTTPS 地址。
APP_URL=https://uperedu.com
# 生成招生邮件链接和校验 Lark 回调使用的正式 HTTPS 来源。
PORTAL_PUBLIC_ORIGIN=https://uperedu.com
# 由应用提供静态站点时，填实际前端构建目录。
TRIAL_FRONTEND_DIRECTORY=

# ── MySQL ──
# 后端使用 MySQL。
PORTAL_DATABASE_DRIVER=mysql
# 正式连接的校验标识，设置此值不会初始化或清除数据。
TRIAL_DATASET=synthetic
# 正式数据库私有连接地址，使用经批准的生产库和内网端点。
MYSQL_TRIAL_URL=
# 正式站启动校验要求经批准的内网 MySQL 直连模式 disabled。
MYSQL_TLS_MODE=disabled

# ── 访问保护与后台任务 ──
# 受保护访问使用的正式 HTTPS 主站来源。
ACCESS_PUBLIC_ORIGIN=https://uperedu.com
# 正式站获准的 HTTPS 来源清单，须包含主站。多个来源以逗号分隔。
ACCESS_ALLOWED_ORIGINS=https://uperedu.com,https://www.uperedu.com,https://home.uperedu.com
# 可信反向代理的具体私网 IP，多个地址以逗号分隔。
ACCESS_TRUSTED_PROXIES=
# 后台 worker 开关。省略时正式站默认开启。首次部署核验或维护时按发布步骤显式控制。
PORTAL_WORKER_ENABLED=true

# ── 集成凭证与浏览器统计 ──
# 后台集成凭证使用的生产专用密钥环。迁移前提供容器内可读的绝对路径，文件权限为 0600，与数据库独立备份。
PORTAL_CREDENTIAL_KEYRING_FILE=
# 前端构建使用的公开 GA4 衡量 ID，须匹配已分配的正式数据流。
VITE_UPER_MEASUREMENT_ID=G-SZCY9WLK8X

# ── 报名与招生邮件 ──
# 默认关闭。权限和存量订单服务联调通过后启用，包括查单、补交凭证、核款和退款。
PORTAL_ENROLLMENT_SERVICE_ENABLED=false
# 默认留空。核对旧队列、发信池和凭证并获发信授权后才设置 smtp。
PORTAL_ENROLLMENT_MAIL_TRANSPORT=

# ── 按需配置 ──
# 调整日志级别时填写。
# PORTAL_LOG_LEVEL=info
# 备份或恢复工具找不到 MySQL 客户端时填写。
# MYSQL_BIN_DIRECTORY=
# 首次初始化预置员工时，通过私有配置提供已约定的统一初始密码。首次登录须修改。已有账号的日常启动可省略。
# ACCESS_INITIAL_PASSWORD=
# 部署层按需提供数据库连接、恢复签名和初始化配置的私有文件。
# PORTAL_BOOTSTRAP_SECRET_FILE=
# 仅获准调用真实供应商核验时启用。
# PORTAL_CREDENTIAL_PROVIDER_CHECKS=false
# 后台尚无模型配置时可覆盖默认 OpenAI 模型。
# OPENAI_MODEL=gpt-6.2-sol
# 按需核对 COS 桶。
# PORTAL_COS_BUCKET=
# 按需核对 COS 桶所在区域。
# PORTAL_COS_REGION=
# 采用默认对象前缀 cms/ 时可省略。
# PORTAL_COS_PREFIX=cms/

# ── 旧版升级兼容 ──
# 仅在实际运行仍依赖旧来源时保留原值。逐项切换和回退条件见生产发布手册。
# OpenAI 与 DeepSeek。逐家迁入后台，确认主备配置读取相应凭证，重启后对应模型调用通过并确认回退来源，再移除该家的旧变量。
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# Lark 应用和群。核对应用、租户、回调、现有员工绑定和群渠道。仍有旧加密 Webhook 时保留对应解密密钥。重启后确认后台凭证和配置有效、回退材料可用，再清理旧值。
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_OAUTH_REDIRECT_URI=https://uperedu.com/api/crm/lark/callback
# LARK_TENANT_KEY=
# LARK_GROUP_CRM=
# LARK_WEBHOOK_ENCRYPTION_KEY=
# 服务端 GA。核对后台正式数据流、凭证和外发状态，重启后确认生效，按批准范围验收事件投递后移除旧变量。
# PORTAL_GA_MEASUREMENT_ID=G-SZCY9WLK8X
# PORTAL_GA_API_SECRET=
# PORTAL_GA_DISPATCH_ENABLED=false
# SMTP。同时保留仍被发件账号引用的旧密码变量。逐账号确认后台解密、重启回读、按授权投递和回退条件后，才移除该账号的旧来源。最后一个依赖迁移后再移除旧密文解密密钥。
# PORTAL_ENROLLMENT_MAIL_CREDENTIAL_KEY=
# COS。确认后台凭证接管同一目标，重启后验证 CMS 媒体读取和所需操作，并确认回退后移除。会话令牌仅用于临时凭证。
# PORTAL_COS_SECRET_ID=
# PORTAL_COS_SECRET_KEY=
# PORTAL_COS_SECURITY_TOKEN=
# 旧 Lark 发送模式。只在沿用尚未迁移模式的旧生产库时保留原值。首次升级后，核对 CRM → 销售运营 → 通知与审计 → 通知渠道，确认群及个人模式均已迁移后移除。
# PORTAL_NOTIFICATION_MODE=
# LARK_PERSONAL_DELIVERY_ENABLED=
