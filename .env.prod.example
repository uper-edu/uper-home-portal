# UPER Home Portal · 正式环境配置模板
# 复制为 .env.prod 后按注释填写。凭证和环境专属地址只写入私有文件。

# ── 运行环境与站点 ──
# 选择 dev、test 或 prod。后端读取对应私有文件，部署时也用它校验构建包目标。
PORTAL_ENV=prod
# 按需。部署系统注入完整环境时设为 injected，由启动器读取私有环境文件时省略。
PORTAL_ENV_SOURCE=injected
# 选择公司测试或正式站的部署校验规则；常规本地开发留空。
PORTAL_DEPLOYMENT=production
# 正式站启动门禁。完成正式环境配置和验收后才设为 true。
PORTAL_PRODUCTION_READY=false
# 控制 Node.js 及依赖的开发／生产运行模式。
NODE_ENV=production
# 标识应用运行场景，本地通常用 local；测试站和正式站用 production，以启用对应的访问保护。
APP_ENV=production
# 选择员工身份来源。local 使用本站员工账号；mock 仅供隔离测试使用。
PLATFORM_MODE=local
# 后端监听端口。本地通常为 3000，部署时由容器和反向代理约定。
PORT=8080
# 站点对外访问的主地址，用于生成站内链接及站点元信息；部署时须符合环境校验。
APP_URL=https://uperedu.com
# 生成招生邮件中的公开链接及验证回跳地址。发布前核对正式 HTTPS 域名。
PORTAL_PUBLIC_ORIGIN=https://uperedu.com
# 后端提供静态页面时读取的前端构建目录，填写当前环境的实际路径。
TRIAL_FRONTEND_DIRECTORY=
# 按需。需要调整日志级别时配置，接受程序默认值时可省略。
PORTAL_LOG_LEVEL=info

# ── MySQL 与数据库工具 ──
# 选择后端数据库驱动。当前 CRM、CMS 的 MySQL 运行方式使用 mysql。
PORTAL_DATABASE_DRIVER=mysql
# 数据库安全场景标识。local-crm 用于本地 CRM；部署使用 synthetic 标识以通过当前校验，它不会初始化或清除数据。
TRIAL_DATASET=synthetic
# MySQL 连接地址，包含数据库账号、密码、主机和库名。只在对应环境的私有配置填写。
MYSQL_TRIAL_URL=
# 正式应用使用经批准的内网 MySQL TCP 直连，启动校验要求 disabled。
MYSQL_TLS_MODE=disabled
# 按需。仅在备份或恢复工具无法从系统路径找到 MySQL 客户端时指定其目录。
MYSQL_BIN_DIRECTORY=

# ── 员工登录、权限与访问保护 ──
# 为账号恢复和受保护操作签名的服务端密钥，部署时至少 32 字符，按环境独立保管。
ACCESS_OPERATION_KEY=
# 指定受保护访问的主站点来源，部署时填写对应的规范 HTTPS 地址。
ACCESS_PUBLIC_ORIGIN=https://uperedu.com
# 允许访问受保护页面和接口的 HTTPS 来源清单，用逗号分隔。
ACCESS_ALLOWED_ORIGINS=https://uperedu.com,https://www.uperedu.com,https://home.uperedu.com
# 填写可信反向代理的具体私网 IP，用逗号分隔；用于判断代理传入的连接信息。
ACCESS_TRUSTED_PROXIES=
# ── 首次初始化预置员工 ──
# 仅本次需要创建预置员工时，通过私有配置提供统一初始密码。已有账号升级可省略，员工首次登录必须改密。
ACCESS_INITIAL_PASSWORD=

# ── 通知后台与 Lark ──
# 正式站回调地址为 https://uperedu.com/api/crm/lark/callback，由腾讯云正式环境的独立发布流程配置。

# 默认启动后台任务。首次部署核验或维护时显式设为 false。
PORTAL_WORKER_ENABLED=true
# 供仍引用 LARK_GROUP_CRM 的生产群渠道读取。实际 Webhook 仅填入私有环境文件。
LARK_GROUP_CRM=
# Lark 企业自建应用的 App ID，用于员工授权绑定和应用机器人身份。
LARK_APP_ID=
# 与 App ID 配对的应用密钥，后端用它获取访问令牌及处理授权。
LARK_APP_SECRET=
# 员工完成 Lark 授权后返回本环境 CRM 的回调地址，须与 Lark 控制台登记值完全一致。
LARK_OAUTH_REDIRECT_URI=https://uperedu.com/api/crm/lark/callback
# 用于核验授权员工是否属于预期的 Lark 企业。
LARK_TENANT_KEY=

# ── 招生邮件 ──
# 加密和解密数据库中的 SMTP 密码。首次保存密码前在正式私有配置提供 32 字节随机值的 64 位十六进制编码。已有凭证时沿用对应密钥。
PORTAL_ENROLLMENT_MAIL_CREDENTIAL_KEY=
# 默认留空，正式环境不启用 SMTP。旧队列、发信池和凭证核对通过并获发信授权后设为 smtp。
PORTAL_ENROLLMENT_MAIL_TRANSPORT=

# ── AI 咨询 ──
# 服务端调用 OpenAI 的凭证，供 AI 咨询等功能使用。
OPENAI_API_KEY=
# 系统尚未保存主模型配置时使用的默认 OpenAI 模型；已保存配置优先。
OPENAI_MODEL=gpt-6.1-sol
# 按需。仅在选择 DeepSeek 作为主模型或备用模型时提供私有凭证。
DEEPSEEK_API_KEY=

# ── Google Analytics ──
# 前端构建所用的公开 GA4 衡量 ID。按目标环境填入 src/data/analyticsEnvironments.json 指定的值。
VITE_UPER_MEASUREMENT_ID=G-SZCY9WLK8X
# 按需。仅在获准启用服务端购买和退款上报时填写，匹配正式 Web 数据流。
PORTAL_GA_MEASUREMENT_ID=G-SZCY9WLK8X
# 按需。仅在获准启用服务端上报时提供同一数据流的 Measurement Protocol 密钥，未获准时保持未注入。
PORTAL_GA_API_SECRET=

# ── CMS 图片与腾讯云 COS ──
# 存储 CMS 图片的 COS 桶名，使用对应环境的桶。
PORTAL_COS_BUCKET=
# 上述 COS 桶所在地域，用于构造请求及资源地址。
PORTAL_COS_REGION=
# 按需。用于指定 CMS 图片对象路径，接受默认的 cms/ 时可省略。
PORTAL_COS_PREFIX=cms/
# 服务端访问 COS 的凭证 ID，用于签名图片上传等请求。
PORTAL_COS_SECRET_ID=
# 与 COS 凭证 ID 配对的私钥，仅服务端用于请求签名。
PORTAL_COS_SECRET_KEY=
# 按需。仅在使用腾讯云临时凭证时提供对应会话令牌，长期凭证可省略。
PORTAL_COS_SECURITY_TOKEN=
