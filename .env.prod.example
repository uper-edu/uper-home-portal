# Production template. Inject real values through the deployment Secret; never commit them.
PORTAL_ENV=prod
PORTAL_ENV_SOURCE=injected
PORTAL_PRODUCTION_READY=true
PORTAL_DEPLOYMENT=production
NODE_ENV=production
APP_ENV=production
PORT=8080
APP_URL=https://home.uperedu.com
PORTAL_DATABASE_DRIVER=mysql
PLATFORM_MODE=local
TRIAL_DATASET=synthetic
MYSQL_TRIAL_URL=mysql://Home:REPLACE_WITH_URL_ENCODED_PASSWORD@10.20.0.9:3306/prod_uper_trial_home
MYSQL_TRIAL_SOCKET=
MYSQL_CA_PEM=
MYSQL_TLS_MODE=disabled
MYSQL_BIN_DIRECTORY=
TRIAL_FRONTEND_DIRECTORY=/app/web
PORTAL_WORKER_ENABLED=false
PORTAL_NOTIFICATION_MODE=simulation
ACCESS_OPERATION_KEY=REPLACE_WITH_RANDOM_STABLE_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_PUBLIC_ORIGIN=https://home.uperedu.com
# Explicit browser/API origins; APP_URL and ACCESS_PUBLIC_ORIGIN remain canonical for generated links.
ACCESS_ALLOWED_ORIGINS=https://home.uperedu.com,https://www.uperedu.com,https://uperedu.com
ACCESS_TRUSTED_PROXIES=REPLACE_WITH_EXACT_INGRESS_POD_IP
ACCESS_ALLOW_TEST_PASSWORDS=false
ACCESS_INITIAL_PASSWORDS_FILE=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
LARK_GROUP_CRM=
LARK_TEST_GROUP=
VITE_UPER_MEASUREMENT_ID=
