{
  "name": "uper-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-start.mjs dev",
    "build": "node scripts/build-portal.mjs dev",
    "build:dev": "node scripts/build-portal.mjs dev",
    "build:test": "node scripts/build-portal.mjs test",
    "build:prod": "node scripts/build-portal.mjs prod",
    "start": "node scripts/start-portal.mjs dev",
    "start:dev": "node scripts/start-portal.mjs dev",
    "start:test": "node scripts/start-portal.mjs test",
    "start:prod": "node scripts/start-portal.mjs prod",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs tests/aiServiceLayout.test.tsx",
    "test:portal": "node --import tsx --test tests/portal.test.ts",
    "migrate:portal": "node --import tsx scripts/portal-migrate.ts",
    "dev:mysql": "node scripts/local-start.mjs dev",
    "start:mysql": "node scripts/start-portal.mjs dev",
    "migrate:mysql": "node cloud/mysql/migrate.mjs",
    "test:mysql": "node --import tsx --test cloud/mysql/tests/*.test.mjs",
    "mysql:catalog": "node scripts/mysql-query-catalog.mjs",
    "worker:mysql": "PORTAL_DATABASE_DRIVER=mysql node scripts/mysql-worker.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.8",
    "mysql2": "3.15.3",
    "nodemailer": "^8.0.10",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  }
}
