# DEEPSEEK_API_KEY: Required for DeepSeek API requests if using DeepSeek backend.
DEEPSEEK_API_KEY="your-deepseek-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail Account credentials used to dispatch inquiry submissions (SMTP)
GMAIL_USER="your-email@gmail.com"
# A secure Gmail App Password (NOT your regular password). 
# See Google Account -> Security -> App passwords.
GMAIL_PASS="your-app-password"

# Optional: recipient email address to receive website inquiries (defaults to service@uperedu.com).
INQUIRY_RECEIVER_EMAIL="service@uperedu.com"

# Optional: recipient email address to receive job applications (defaults to hr@uperedu.com).
CAREERS_RECEIVER_EMAIL="hr@uperedu.com"

# Optional: general fallback recipient email address if specific ones are empty.
RECEIVER_EMAIL="service@uperedu.com"

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_UPER_MEASUREMENT_ID=


# AI chat: OpenAI primary; DeepSeek fallback when its key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEFAULT_AI_PROVIDER=openai
# Optional full Chat Completions endpoint (not just a base URL).
# OPENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions
