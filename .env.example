# Choose exactly one environment; this legacy filename is not auto-loaded.
# Local development: copy .env.dev.example to private .env.dev
# Company test: copy .env.test.example to private .env.test
# Future production: copy .env.prod.example to private .env.prod
# Never commit actual .env.dev / .env.test / .env.prod files or secrets.
# Frontend variables must use VITE_; database/AI/Webhook credentials must never use that prefix.

# Optional server-side CRM payment analytics, disabled unless explicitly provisioned.
# PORTAL_GA_DISPATCH_ENABLED=false
# PORTAL_GA_MEASUREMENT_ID=
# PORTAL_GA_API_SECRET=
# PORTAL_GA_START_AT=
