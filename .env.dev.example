# UPER Home Portal · 本地开发配置模板
# 复制为 .env.dev 后填写私有值，文件权限为 0600。

# ── 运行与站点 ──
PORTAL_ENV=dev
NODE_ENV=development
APP_ENV=local
PLATFORM_MODE=local
PORT=3000
APP_URL=http://localhost:3000
# 招生邮件链接和 Lark 回调校验使用的来源。只填协议、主机和端口。
PORTAL_PUBLIC_ORIGIN=http://localhost:3000
# 前端静态构建目录。启动脚本可按实际构建覆盖。
TRIAL_FRONTEND_DIRECTORY=build/dev/web

# ── 本地 MySQL ──
PORTAL_DATABASE_DRIVER=mysql
TRIAL_DATASET=local-crm
PORTAL_LOCAL_CUTOVER=true
# 本地 CRM 的 MySQL 连接地址，目标库为 uper_local_crm。
MYSQL_TRIAL_URL=
# 本地 CRM 使用固定的 Unix socket，与连接地址配套。
MYSQL_TRIAL_SOCKET=/private/tmp/uper-crm-mysql-local3000.sock

# ── 访问保护与后台任务 ──
# 后台任务开关。按当前环境运行要求设置。
PORTAL_WORKER_ENABLED=true

# ── 集成凭证与浏览器统计 ──
# 后台集成凭证密钥环的绝对路径，文件权限为 0600。
PORTAL_CREDENTIAL_KEYRING_FILE=
# 前端构建使用的公开 GA4 衡量 ID，须匹配 dev 数据流。
VITE_UPER_MEASUREMENT_ID=G-RTB5CWXVWV

# ── 本地 MySQL 工具（按需） ──
# 备份和恢复使用的 MySQL 客户端工具目录。
# MYSQL_BIN_DIRECTORY=
# 项目脚本托管 MySQL 时，同时设置 mysqld 路径和私有数据目录。
# PORTAL_MYSQL_MANAGED_BINARY=
# PORTAL_MYSQL_MANAGED_DIRECTORY=

# ── 其他按需配置 ──
# 日志级别可通过 PORTAL_LOG_LEVEL 调整。
# MySQL 网络连接的 TLS 配置使用 MYSQL_TLS_MODE 和 MYSQL_CA_PEM。
# 反向代理使用 ACCESS_PUBLIC_ORIGIN 和 ACCESS_TRUSTED_PROXIES。
# 首次初始化账号时私下提供 ACCESS_INITIAL_PASSWORD。部署层可用 PORTAL_BOOTSTRAP_SECRET_FILE 提供启动凭证。
# PORTAL_CREDENTIAL_PROVIDER_CHECKS 仅在获准调用供应商时启用。
# OPENAI_MODEL=gpt-6.2-sol
# OPENAI_MODEL 仅在尚无后台模型配置时生效。
# 招生模拟邮件见 README。隔离测试才使用 ACCESS_ALLOW_TEST_PASSWORDS 或 MOCK_EMPLOYEE_ID。

# ── 旧环境兼容 ──
# 日常通过系统管理配置 LLM、Lark、GA 和 COS。迁移、旧变量及回退见 docs/integration-credentials-runbook.md。
# COS 目标按需配置 PORTAL_COS_BUCKET、PORTAL_COS_REGION 和 PORTAL_COS_PREFIX。
# PORTAL_GA_DISPATCH_ENABLED=false
# 此旧开关仅在无后台 GA 设置时生效，须获准后启用外发。
