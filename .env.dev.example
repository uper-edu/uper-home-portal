# UPER Home Portal · 本地开发配置模板
# 复制为 .env.dev 后按注释填写。凭证和环境专属地址只写入私有文件。

# ── 运行环境与站点 ──
# 选择 dev、test 或 prod。后端读取对应私有文件，部署时也用它校验构建包目标。
PORTAL_ENV=dev
# 控制 Node.js 及依赖的开发／生产运行模式。
NODE_ENV=development
# 标识应用运行场景，本地通常用 local；测试站和正式站用 production，以启用对应的访问保护。
APP_ENV=local
# 选择员工身份来源。local 使用本站员工账号；mock 仅供隔离测试使用。
PLATFORM_MODE=local
# 后端监听端口。本地通常为 3000，部署时由容器和反向代理约定。
PORT=3000
# 站点对外访问的主地址，用于生成站内链接及站点元信息；部署时须符合环境校验。
APP_URL=http://localhost:3000
# 后端提供静态页面时读取的前端构建目录，填写当前环境的实际路径。
TRIAL_FRONTEND_DIRECTORY=
# 控制服务端日志输出级别，info 记录常规运行信息。
PORTAL_LOG_LEVEL=info

# ── MySQL 与本地数据库工具 ──
# 选择后端数据库驱动。当前 CRM、CMS 的 MySQL 运行方式使用 mysql。
PORTAL_DATABASE_DRIVER=mysql
# 数据库安全场景标识。local-crm 用于本地 CRM；部署使用 synthetic 标识以通过当前校验，它不会初始化或清除数据。
TRIAL_DATASET=local-crm
# 为本地 CRM 选择经校验的私有 MySQL 实例，仅用于本地开发。
PORTAL_LOCAL_CUTOVER=true
# MySQL 连接地址，包含数据库账号、密码、主机和库名。只在对应环境的私有配置填写。
MYSQL_TRIAL_URL=
# 同机 MySQL 的 Unix socket 路径。本地 CRM 使用；容器或网络连接留空。
MYSQL_TRIAL_SOCKET=
# MySQL 传输设置。仅项目允许的内网直连可以填 disabled，其他连接遵循 TLS 校验。
MYSQL_TLS_MODE=
# 远程 MySQL 启用 TLS 时用于验证服务器身份的 CA 证书内容。
MYSQL_CA_PEM=
# mysql、mysqldump 等客户端工具目录，供数据库备份与恢复使用。
MYSQL_BIN_DIRECTORY=
# 本地启动器托管 MySQL 时使用的 mysqld 可执行文件路径；已有独立服务时留空。
PORTAL_MYSQL_MANAGED_BINARY=
# 本地托管 MySQL 实例的私有目录，与上面的 mysqld 路径配合使用。
PORTAL_MYSQL_MANAGED_DIRECTORY=

# ── 员工登录、权限与访问保护 ──
# 为账号恢复和受保护操作签名的服务端密钥，部署时至少 32 字符，按环境独立保管。
ACCESS_OPERATION_KEY=
# 指定受保护访问的主站点来源，部署时填写对应的规范 HTTPS 地址。
ACCESS_PUBLIC_ORIGIN=
# 填写可信反向代理的具体私网 IP，用逗号分隔；用于判断代理传入的连接信息。
ACCESS_TRUSTED_PROXIES=
# 仅隔离模拟测试可启用固定测试密码，其他环境保持 false。
ACCESS_ALLOW_TEST_PASSWORDS=false
# 仅 mock 身份模式读取，用于选择模拟登录员工；local 模式使用真实登录会话。
MOCK_EMPLOYEE_ID=

# ── 通知进程与 Lark ──
# 控制通知后台进程是否运行，关闭时页面和接口仍可运行。
PORTAL_WORKER_ENABLED=true
# simulation 用于模拟；configured 按当前配置处理渠道，符合条件的 Lark 渠道可能真实发送。
PORTAL_NOTIFICATION_MODE=configured
# 系统 Lark 群机器人的完整 Webhook 地址。仅填写在本地私有环境文件。
LARK_GROUP_CRM=
# 允许真实发送的测试 Lark 渠道 ID，对应 CRM 渠道记录，不填写 Webhook。
LARK_TEST_GROUP=
# Lark 企业自建应用的 App ID，用于员工授权绑定和应用机器人身份。
LARK_APP_ID=
# 与 App ID 配对的应用密钥，后端用它获取访问令牌及处理授权。
LARK_APP_SECRET=
# 员工完成 Lark 授权后返回本环境 CRM 的回调地址，须与 Lark 控制台登记值完全一致。
LARK_OAUTH_REDIRECT_URI=
# 用于核验授权员工是否属于预期的 Lark 企业。
LARK_TENANT_KEY=
# 启用自助绑定及确认消息。新绑定或换绑可直接发送一次确认消息，即使普通通知进程关闭。
LARK_BINDING_CONFIRMATIONS_ENABLED=false
# 控制是否允许按负责人发送 Lark 个人业务通知，需应用凭证及有效绑定。
LARK_PERSONAL_DELIVERY_ENABLED=true

# ── AI 咨询 ──
# 服务端调用 OpenAI 的凭证，供 AI 咨询等功能使用。
OPENAI_API_KEY=
# 系统尚未保存主模型配置时使用的默认 OpenAI 模型；已保存配置优先。
OPENAI_MODEL=gpt-6.1-sol
# 服务端调用 DeepSeek 的凭证，用于配置为 DeepSeek 的模型调用和故障切换。
DEEPSEEK_API_KEY=

# ── Google Analytics ──
# 前端构建所用的公开 GA4 衡量 ID。按目标环境填入 src/data/analyticsEnvironments.json 指定的值。
VITE_UPER_MEASUREMENT_ID=
# 历史 GA 隔离验收脚本读取的测试流密钥。仅 dev／test 使用，与当前发送器的 API_SECRET 分开。
PORTAL_GA_STAGING_API_SECRET=
# 是否允许 GA 购买／退款发送器外发。默认关闭；启用还须通过环境、同意和客户标识检查。
PORTAL_GA_DISPATCH_ENABLED=false
# 服务端购买／退款事件目标的 GA4 衡量 ID，须匹配当前环境分配的数据流。
PORTAL_GA_MEASUREMENT_ID=
# 服务端购买／退款发送器使用的 Measurement Protocol 密钥，须对应同一数据流。
PORTAL_GA_API_SECRET=
# 允许外发事件的起算时刻，使用带 Z 的 ISO 8601 UTC 时间。早于该时刻的历史事件不补发。
PORTAL_GA_START_AT=

# ── CMS 图片与腾讯云 COS ──
# 存储 CMS 图片的 COS 桶名，使用对应环境的桶。
PORTAL_COS_BUCKET=
# 上述 COS 桶所在地域，用于构造请求及资源地址。
PORTAL_COS_REGION=
# CMS 图片在桶中的对象路径前缀，默认 cms/。
PORTAL_COS_PREFIX=cms/
# 服务端访问 COS 的凭证 ID，用于签名图片上传等请求。
PORTAL_COS_SECRET_ID=
# 与 COS 凭证 ID 配对的私钥，仅服务端用于请求签名。
PORTAL_COS_SECRET_KEY=
# 使用腾讯云临时凭证时配套填写的会话令牌；长期凭证留空。
PORTAL_COS_SECURITY_TOKEN=
