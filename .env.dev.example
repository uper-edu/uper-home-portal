# UPER Home Portal · 本地开发配置模板
# 复制为 .env.dev 后填写私有值，文件权限为 0600。

# ── 运行与站点 ──
# Home Portal 开发配置使用 UPER_PORTAL_。旧 PORTAL_ 名称仍可读取。
UPER_PORTAL_ENV=dev
NODE_ENV=development
APP_ENV=local
PLATFORM_MODE=local
PORT=3000
APP_URL=http://localhost:3000
# 招生邮件链接和 Lark 回调校验使用的来源。只填协议、主机和端口。
UPER_PORTAL_PUBLIC_ORIGIN=http://localhost:3000
# 前端静态构建目录。启动脚本可按实际构建覆盖。
TRIAL_FRONTEND_DIRECTORY=build/dev/web

# ── 本地 MySQL ──
TRIAL_DATASET=local-crm
UPER_PORTAL_LOCAL_CUTOVER=true
# 本地 CRM 的 MySQL 连接地址，目标库为 uper_local_crm。
MYSQL_TRIAL_URL=
# 本地 CRM 使用固定的 Unix socket，与连接地址配套。
MYSQL_TRIAL_SOCKET=/private/tmp/uper-crm-mysql-local3000.sock

# ── 集成凭证 ──
# 后台集成凭证密钥环的绝对路径，文件权限为 0600。
UPER_PORTAL_CREDENTIAL_KEYRING_FILE=

# ── 本地 MySQL 工具（按需） ──
# MYSQL_BIN_DIRECTORY=
# 项目脚本托管 MySQL 时，同时设置 mysqld 路径和私有数据目录。
# UPER_PORTAL_MYSQL_MANAGED_BINARY=
# UPER_PORTAL_MYSQL_MANAGED_DIRECTORY=

# ── 其他按需配置 ──
# 日志级别可通过 UPER_PORTAL_LOG_LEVEL 调整。
# MySQL 网络连接的 TLS 配置使用 MYSQL_TLS_MODE 和 MYSQL_CA_PEM。
# 反向代理使用 UPER_PORTAL_PUBLIC_ORIGIN 和 ACCESS_TRUSTED_PROXIES。
# 全新本地库首次启动前，在私有 .env.dev（权限 0600）设置临时密码。
# 预置账号首次登录必须改密。确认账号初始化成功后，可从私有配置移除此项。
# ACCESS_INITIAL_PASSWORD=
# 也可通过 UPER_PORTAL_BOOTSTRAP_SECRET_FILE 指向的私有文件提供启动凭证。
# ANTHROPIC_API_KEY=  # 可选，优先使用后台 Anthropic 凭证。
# OPENAI_MODEL=gpt-6.2-sol
# OPENAI_MODEL 仅在尚无后台模型配置时生效。
# 招生模拟邮件见 README。隔离测试才使用 ACCESS_ALLOW_TEST_PASSWORDS 或 MOCK_EMPLOYEE_ID。

# ── 旧环境兼容 ──
# 日常通过系统管理配置 LLM、Lark、GA 和 COS。迁移、旧变量及回退见 docs/integration-credentials-runbook.md。
# COS 目标按需配置 UPER_PORTAL_COS_BUCKET、UPER_PORTAL_COS_REGION 和 UPER_PORTAL_COS_PREFIX。
# UPER_PORTAL_GA_DISPATCH_ENABLED=false
# 此旧开关仅在无后台 GA 设置时生效，须获准后启用外发。
