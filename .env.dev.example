# Localhost development. Copy to private .env.dev; never commit real values.
PORTAL_ENV=dev
NODE_ENV=development
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
PORTAL_DATABASE_DRIVER=mysql
PLATFORM_MODE=local
TRIAL_DATASET=local-crm
PORTAL_LOCAL_CUTOVER=true
MYSQL_TRIAL_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@localhost/uper_local_crm
MYSQL_TRIAL_SOCKET=/private/tmp/uper-crm-mysql-local3000.sock
MYSQL_CA_PEM=
MYSQL_TLS_MODE=
MYSQL_BIN_DIRECTORY=REPLACE_WITH_LOCAL_MYSQL_BIN
TRIAL_FRONTEND_DIRECTORY=build/dev/web
PORTAL_WORKER_ENABLED=true
PORTAL_NOTIFICATION_MODE=configured
# Console log threshold: debug | info | warn | error. Single-line JSON on stdout/stderr for container collection.
# Set it in this file (or injected container env); a shell-exported value is cleared when this env file loads.
PORTAL_LOG_LEVEL=info
ACCESS_OPERATION_KEY=REPLACE_WITH_EXISTING_STABLE_LOCAL_KEY
ACCESS_PUBLIC_ORIGIN=
ACCESS_TRUSTED_PROXIES=
ACCESS_ALLOW_TEST_PASSWORDS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
LARK_GROUP_CRM=
LARK_TEST_GROUP=CRM_Leads_Update
# Assigned public GA stream: src/data/analyticsEnvironments.json; see docs/analytics/ga4-environments.md
VITE_UPER_MEASUREMENT_ID=

# CMS media is stored in COS; secrets are server-only (never use VITE_).
PORTAL_COS_BUCKET=uper-portal-public-20261104191752-1433456541
PORTAL_COS_REGION=ap-jakarta
PORTAL_COS_PREFIX=cms/
PORTAL_COS_SECRET_ID=REPLACE_WITH_SCOPED_SECRET_ID
PORTAL_COS_SECRET_KEY=REPLACE_WITH_SCOPED_SECRET_KEY
PORTAL_COS_SECURITY_TOKEN=

# Optional explicitly approved remote development profile; replace the local
# dataset/socket settings above, do not combine the two profiles.
# PORTAL_DEPLOYMENT=remote-dev
# PORTAL_REMOTE_DEV_APPROVED=true
# TRIAL_DATASET=synthetic
# MYSQL_TRIAL_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@cn60.monite.cn:3306/uper_trial_home
# MYSQL_TRIAL_SOCKET=
# PORTAL_WORKER_ENABLED=false
# MYSQL_TLS_MODE=required
# MYSQL_CA_PEM=REPLACE_WITH_TRUSTED_CA
# Only this exact dev target may use MYSQL_TLS_MODE=disabled after explicit approval.
